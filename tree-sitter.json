{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "esker",
      "camelcase": "Esker",
      "title": "Esker",
      "scope": "source.esker",
      "file-types": [
        "esker"
      ],
      "injection-regex": "^esker$",
      "class-name": "TreeSitterEsker"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Esker grammar for tree-sitter",
    "authors": [
      {
        "name": "Nikhil Idiculla",
        "email": "nikhil.idiculla@gmail.com",
        "url": "https://github.com/tsnl"
      }
    ],
    "links": {
      "repository": "https://github.com/tsnl/tree-sitter-esker",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}